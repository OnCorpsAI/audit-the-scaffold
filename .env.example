# Copy to .env and fill in for your environment. Never commit .env.
#
# Every path here is environment-specific and deliberately shown as a placeholder:
# real repository paths and roster locations must live outside this repository.
# Values marked SECRET must never be committed anywhere.

# --- Part C: cohort extraction (git_session_extractor.py) -------------------

# Comma-separated absolute paths to the repositories to extract. Required:
# extraction fails closed rather than writing an empty dataset.
COMPANY_REPOS=/path/to/repoA,/path/to/repoB,/path/to/repoC

# Directory of clones scanned by scripts/discover_cohorts.py --root to derive
# both cohorts and the AI-adoption cutoff.
COMPANY_REPO_ROOT=/path/to/all-clones

# Where discover_cohorts.py writes its manifest. Must be OUTSIDE this repo --
# the manifest holds real repository paths and the script checks for that.
COMPANY_COHORTS_OUT=/path/to/private-dir/cohorts.json

# SECRET. Arbitrary secret string; HMAC salt for repo labels and developer
# hashes. Changing it permutes every label, so keep one salt per released
# dataset generation or the two cohorts stop being comparable.
COMPANY_HASH_SALT=

# Curated author rosters (strict allowlists produced by
# scripts/resolve_author_aliases.py --from-reviewed). SECRET: these map real
# names and email addresses to person labels, which is why they are not
# releasable. One roster per cohort, because each is built over its own window;
# within-era mode uses the AI-era roster for both sides.
COMPANY_ALIAS_MAP=/path/to/private-dir/roster_ai_tier.json
COMPANY_CONTROL_ALIAS_MAP=/path/to/private-dir/roster_control.json

# Pre-AI human baseline (Finding 3). COMPANY_CONTROL_MODE=1 requires
# COMPANY_CONTROL_UNTIL; SINCE is optional and sizes the window.
COMPANY_CONTROL_MODE=
COMPANY_CONTROL_SINCE=2021-11-08
COMPANY_CONTROL_UNTIL=2022-09-19

# Within-era AI vs non-AI contrast. Set MODE to 'ai' or 'nonai'; both SINCE and
# UNTIL are then required, and must match across the two sides, or the contrast
# differs in more than the one respect it is meant to isolate.
COMPANY_WITHIN_ERA_MODE=
COMPANY_WITHIN_ERA_SINCE=
COMPANY_WITHIN_ERA_UNTIL=

# --- Part C: release sanitization (scripts/anonymize_sessions.py) -----------

# Raw (un-anonymized) extractor output to sanitize. Keep outside this repo.
RAW_SESSIONS_PATH=/path/to/private-dir/raw_sessions.json

# Real -> synthetic repository name mapping, inline JSON or a file path
# (COMPANY_REPO_MAP takes precedence). With neither set the rename pass is a
# no-op, which is what you want when re-running on already-anonymized data.
COMPANY_REPO_MAP=
COMPANY_REPO_MAP_FILE=/path/to/private-dir/repo_map.json

# --- Part B: LiteLLM proxy credentials -------------------------------------

# Required: no endpoint is baked into source (DEFAULT_API_BASE is None).
LITELLM_API_BASE=
# SECRET.
LITELLM_API_KEY=

# --- Part B: experiment configuration (llm_simulations.py) ------------------
# Values shown are the in-source defaults. The paper's Part B runs used
# K=55, T=4, seeds=4, tau=0.6, temperature=0.25.

LLM_SIM_MODEL=litellm_proxy/claude-haiku-4-5-20251001
LLM_SIM_TIER_MODELS=
LLM_SIM_TIER_POLICY=fixed
LLM_SIM_K=5
LLM_SIM_T=4
LLM_SIM_SEEDS=1
LLM_SIM_SEED_BASE=0
LLM_SIM_TAU=0.6
LLM_SIM_TEMPERATURE=0.25
LLM_SIM_FEEDBACK=diagnostic
LLM_SIM_AGENT=mini
LLM_SIM_EVALUATOR=proxy
LLM_SIM_HARNESS_BACKEND=local
LLM_SIM_CONCURRENCY=1
LLM_SIM_STEP_LIMIT=40
LLM_SIM_APPLY_CHECK=0
LLM_SIM_EXCLUDE_IDS=
LLM_SIM_JUDGE_MODEL=litellm_proxy/claude-opus-4-8
LLM_SIM_PANEL_PRIMARY=file_f1

# LLM_SIM_TIER_MODELS: comma-separated tier models; empty means a single model.
# LLM_SIM_FEEDBACK:    independent | blind | diagnostic.
# LLM_SIM_EXCLUDE_IDS: comma-separated SWE-bench instance ids to skip.

# --- Part B: Docker/Modal evaluation harness -------------------------------

LLM_HARNESS_PLATFORM=linux/amd64
LLM_HARNESS_PULL_TIMEOUT=600
LLM_HARNESS_EVAL_TIMEOUT=300
LLM_HARNESS_SANDBOX_TIMEOUT=900
LLM_HARNESS_MODAL_TIMEOUT=120
LLM_HARNESS_AUTO_REMOVE=0
